+        raise RuntimeError(f"pinned size drift for {path}: {receipt['bytes']} != {expected_bytes}")
+    if receipt["sha256"] != expected_sha:
+        raise RuntimeError(f"pinned sha drift for {path}: {receipt['sha256']} != {expected_sha}")
+    return receipt
