+def packed_frame(path: Path, frame: int) -> np.ndarray:
+    packed = np.memmap(
+        path,
+        dtype=np.uint8,
+        mode="r",
+        offset=frame * PACKED_FRAME_BYTES,
+        shape=(PACKED_FRAME_BYTES,),
