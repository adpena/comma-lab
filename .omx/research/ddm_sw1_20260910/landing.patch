+def _fs2_import_up3(store: Path) -> Any:
+    """Load the vendored carrier-splice encoder from the materialized sources."""
+    source = vendor_file("up3_carrier_splice.py")
+    require_pin(source, MATERIALIZED_SOURCE_PINS["up3_carrier_splice.py"])
+    spec = importlib.util.spec_from_file_location("_ps2_up3_carrier_splice", source)
+    if spec is None or spec.loader is None:
+        raise CompressionError(f"cannot load the carrier-splice encoder from {source}")
+    module = importlib.util.module_from_spec(spec)
+    # ``dataclasses`` resolves a frozen class's annotations through
+    # ``sys.modules[cls.__module__]``, so the module must be registered BEFORE it
+    # executes or ``@dataclass(frozen=True)`` raises on its own field types.
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
