+def decode_rr4_context(context: np.ndarray) -> dict[str, np.ndarray]:
+    packed = np.asarray(context, dtype=np.int64)
+    boundary = packed % 5
+    rest = packed // 5
+    run = rest % 8
+    rest //= 8
+    agree2 = rest % 2
+    rest //= 2
+    agree1 = rest % 2
+    rest //= 2
+    ubin = rest % 64
+    base_class = rest // 64
+    return {
+        "base_class": base_class,
+        "surprise_bin": ubin,
+        "agree_t_minus_1": agree1,
+        "agree_t_minus_2": agree2,
+        "run_level": run,
+        "boundary_bucket": boundary,
+    }
+
