+#: Digests of the two 600x12 int32 code tables, C-order ``tobytes``.
+FS1_CODES_SHA256 = "1a5b7a46930f653b2b796555961548af2e52f89adcf909ffd2e4d1b928c9fda8"
+FS2_CODES_SHA256 = "5f7ca86e82d5c42d7cf3b55e7c04101241b73b3ecc83084de7a76ce8b40b212f"
+#: The blob the FS2 choices must encode to.  Same length as FS1's, different bytes.
+FS2_SELECTOR_BLOB_SHA256 = "15c256dcb6a6563966b43f51f2616d7f1c03d16e1812a8dcb5d80ceea432ddd0"
+FS2_SELECTOR_BLOB_BYTES = 34
