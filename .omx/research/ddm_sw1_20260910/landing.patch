+
+    with zipfile.ZipFile(DX2_ARCHIVE) as archive:
+        if archive.namelist() != ["p"] or archive.getinfo("p").compress_type != zipfile.ZIP_STORED:
+            raise RuntimeError("DX2 ZIP member contract drift")
