+def cleanup_incomplete_temps(output: Path) -> list[dict[str, Any]]:
+    """Certify and remove only this runner's atomic-write scratch remnants."""
+    cleanup_path = output / "CLEANUP.json"
+    prior: list[dict[str, Any]] = []
