+#: The RC64 encoder-bearing source, pinned by ddm_rr2 (`RC64_SOURCE_SHA`).
+RC64_BASE_SHA = "5c75e2c70b89f148bc9d117d4dbd39a24dfb2e72ec41b0a7e9b9cf490ca07ee6"
+ROUTE_B = REPO / "compress_vendor/route_b_rc64.py"
