+    mixer = np.memmap(fields["mixer"]["path"], dtype=CELL_DTYPE, mode="r", shape=(N, HEIGHT, WIDTH))
+    miss = np.memmap(fields["miss"]["path"], dtype=CELL_DTYPE, mode="r", shape=(N, HEIGHT, WIDTH))
