+    def groupbin8_surprise(f):
+        return (f["cls"] * GROUP_BINS + f["groupbin8"]) * U_BINS + f["ubin"]
+
+    specs.update(
+        {
+            "groupbin8_only": (GROUP_BINS, groupbin8_only),
+            "cls_groupbin8": (NUM_CLASSES * GROUP_BINS, cls_groupbin8),
+            "groupbin8_surprise": (
+                NUM_CLASSES * GROUP_BINS * U_BINS,
