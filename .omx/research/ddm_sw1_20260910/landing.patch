+def parse_anatomy(member: bytes, archive_bytes: int) -> tuple[dict[str, Any], bytes]:
+    magic, version, codec, table_mode, feature_bits, hpac_len, semantic_len, carrier_len = (
+        RX1_HEADER.unpack_from(member)
