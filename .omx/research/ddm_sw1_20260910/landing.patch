+def entropy_bits(counts: np.ndarray) -> float:
+    positive = np.asarray(counts, dtype=np.float64)
+    positive = positive[positive > 0]
+    total = float(positive.sum())
+    if total == 0:
+        return 0.0
+    return float(np.sum(positive * (math.log2(total) - np.log2(positive))))
