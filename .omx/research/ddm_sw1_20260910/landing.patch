+def order_shape_only(tokens: np.ndarray, order: np.ndarray, temporal_inner: bool) -> bytes:
+    frames = np.asarray(tokens).reshape(T, SITES)
+    arranged = frames[:, order]
+    if temporal_inner:
+        arranged = arranged.T
+    return np.ascontiguousarray(arranged).tobytes()
