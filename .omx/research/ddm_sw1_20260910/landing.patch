+        prior = json.loads(cleanup_path.read_text()).get("entries", [])
+    targets = sorted(
+        path
+        for path in output.rglob(".*.tmp.*")
+        if path.is_file() and path != cleanup_path
+    )
+    if not targets:
+        return prior
+    pending = [
+        {
