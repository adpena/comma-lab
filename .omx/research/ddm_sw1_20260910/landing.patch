+            {
+                "top_position_fraction": fraction,
+                "positions": count,
+                "position_denominator": POSITIONS,
+                "bits": bits,
+                "bit_denominator": total_frequency_bits,
+                "bit_fraction": bits / total_frequency_bits,
+                "bytes_equivalent": bits / 8.0,
+                "threshold_bits": threshold,
