+# DDM_SZ1_SEMANTIC_METADATA_SPLIT_V1 -- free receiver code, zero transmitted bytes.
+SZ1_RESERVED_SEMANTIC_SPLIT = 0x01
+# DDM_CK2_WHOLE_SECTION_PLANE2_V1
+# Bits 1 and 2 mark a 2-plane byte de-interleave over the WHOLE decompressed section
+# body.  Unlike bit 0 this carries no fitted offset/length: the transform is a pure
+# permutation of the entire buffer, so it re-fits nothing when the body layout changes.
+CK2_RESERVED_SEMANTIC_PLANE2 = 0x02
+CK2_RESERVED_CARRIER_PLANE2 = 0x04
+# DDM_RR5_ARITH_BASIS_V1: the basis rider's reserved bit.
+RR5_RESERVED_ARITH_BASIS = 0x08
+# DDM_DX2_CABAC_COEFFICIENTS_V1: disjoint coefficient-stream rider.
+DX2_RESERVED_CABAC_COEFFICIENTS = 0x10
+# DDM_RC1_ADAPTIVE_MODEL_SECTIONS_V1: the two MODEL sections' adaptive-recode bits.
+# Both are additive: an archive with either bit clear takes exactly the path it takes
+# today, and an unknown bit still refuses fail-closed through the mask below.
+RC1_RESERVED_SEMANTIC_ADAPTIVE = 0x20
+RC1_RESERVED_HPAC_ADAPTIVE = 0x40
+# DDM_KW1_WIDE_RICE_K_V1: the packed CAP1 metadata block carries the twelve
+# Rice parameters as 4-bit absolute nibbles instead of k_base + a 1-bit field,
+# so the block is 43 bytes instead of 40.  Additive: an archive with this bit
+# clear takes exactly the path it takes today.
+KW1_RESERVED_WIDE_RICE_K = 0x80
+KW1_PACKED_METADATA_BYTES = 43
+SZ1_RESERVED_KNOWN_BITS = 0xFF
+
