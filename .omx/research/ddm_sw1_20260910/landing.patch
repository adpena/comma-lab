+def load_runtime(root: Path):
+    """Import the shipped runtime package and the cpr1 renderer module."""
+    root = root.resolve()
+    if str(root) not in sys.path:
+        sys.path.insert(0, str(root))
+    renderer_dir = root / "cpr1"
