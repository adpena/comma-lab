+#!/usr/bin/env python3
+"""Execute the STAGED compress.py stage 7 against the pinned FS1 archive.
+
+This is not a simulation: it imports the staged public encoder, runs its own
+tree-manifest verification, materializes its embedded encoder sources, stages a
+real receiver runtime on the FS1 body, and calls ``fold_fs2_stage``.  The stage
+refuses unless the rebuilt archive is exactly the pinned FS2 SHA-256.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import shutil
+import sys
+import time
+from pathlib import Path
+
+STAGING = Path("/Volumes/APDataStore/pact/ddm_ps2_pr140_update_prep")
+PACKET = STAGING / "packet"
+FS1 = STAGING / "evidence" / "inputs" / "fs1_archive_pointer.zip"
+# The work store lives on the local APFS disk: the SSD tier is ExFAT, where macOS
+# materializes every extended attribute as an AppleDouble "._" sidecar, and the
+# encoder correctly refuses a runtime tree carrying that hidden state.  Only the
+# retained payloads and receipts are written back to the SSD staging tree.
+STORE = Path(".omx/tmp/ddm_ps2_stage7").resolve() / sys.argv[1]
+EXPECT_SHA = "a8f3a3791499b2b62ee4d16bc67f15f819f454dc9b88e3cce04fe50a30427bb6"
+EXPECT_BYTES = 180_023
+
+
+def load_staged_compress():
+    spec = importlib.util.spec_from_file_location("staged_compress", PACKET / "compress.py")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules["staged_compress"] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def main() -> int:
+    started = time.time()
+    if STORE.exists():
+        shutil.rmtree(STORE)
+    STORE.mkdir(parents=True)
+    cx = load_staged_compress()
+    receipt = {
+        "schema": "ddm_ps2.stage7_rebuild.v1",
+        "axis": "[bytes -- exact, device-free]",
+        "score_claim": False,
+        "promotable": False,
+        "run_label": sys.argv[1],
+        "staged_packet": str(PACKET),
