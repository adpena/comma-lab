+def _fs2_codes(shipped: Any) -> tuple[Any, list[int], int]:
+    """Overlay the recorded rows onto the shipped table; count what actually moved."""
+    import numpy as np
+
+    codes = np.array(shipped, dtype=np.int32, copy=True)
+    if codes.shape != (FS1_FRAME_COUNT, 12):
+        raise CompressionError(f"shipped codes are {codes.shape}, expected (600, 12)")
+    seen: set[int] = set()
+    for pair, row in FS2_CARRIER_ROWS:
+        if not 0 <= pair < FS1_FRAME_COUNT:
+            raise CompressionError(f"carrier row pair out of range: {pair}")
+        if pair in seen:
+            raise CompressionError(f"carrier row {pair} appears twice")
+        seen.add(pair)
+        if len(row) != 12:
+            raise CompressionError(f"carrier row {pair} has {len(row)} coordinates, expected 12")
+        if any(not -2048 <= int(v) <= 2047 for v in row):
+            raise CompressionError(f"carrier row {pair} escapes the signed-int12 domain")
+        codes[pair, :] = np.asarray(row, dtype=np.int32)
+    changed = np.asarray(shipped, dtype=np.int32) != codes
+    changed_pairs = [int(p) for p in np.flatnonzero(changed.any(axis=1))]
+    changed_coordinates = int(changed.sum())
+    return codes, changed_pairs, changed_coordinates
+
+
+class _Fs2ReceiverView:
+    """The three receiver modules ``_fs1_parse_back`` reads, bound to one runtime.
+
+    Stage 6 carries them on its own body object; stage 7's body comes from the
+    vendored splice encoder, so the same parse-back helper is handed this view
+    rather than being duplicated.
+    """
+
+    def __init__(self, residual_archive: Any, frame0_selector: Any, carrier_repack: Any):
+        self.ra = residual_archive
+        self.f0s = frame0_selector
+        self.repack = carrier_repack
+
+
+def fold_fs2_stage(store: Path, runtime: Path, pointer: Path) -> tuple[Path, dict[str, Any]]:
+    """Re-solve the CAP1 carrier on the re-selected pairs; +1 byte, nothing else moves.
+
+    Lossless in the only sense that matters here: it re-encodes ONE section of
+    the archive (plus, on the alternation, the contents of a same-length
+    selector blob) and proves through the receiver's own parser that every
+    other section comes back byte-identical.  It refuses on six separate
+    grounds -- an unpinned pointer, shipped codes that are not FS1's, a failed
+    container identity control, a code table that is not the recorded one, a
+    parse-back that is not one-variable, and a final SHA-256 that is not the
+    pinned FS2 archive -- and repeats the whole splice once in memory.
+    """
+    import numpy as np
+
+    started = time.monotonic()
+    store.mkdir(parents=True, exist_ok=True)
+    pointer_fact = require_pin(pointer, FS1_SHA256, FS1_BYTES)
+
+    # Import the receiver FIRST so up3's ``from runtime import ...`` reuses these
+    # exact module objects instead of re-executing them under a purged cache.
+    ra, _rr5, _dx2, f0s, repack = _fs1_import_runtime(runtime)
+    up3 = _fs2_import_up3(store)
+    # ``verify_sha=False`` disables up3's OWN generation's pointer gate; the gate
+    # that binds here is ``require_pin`` above, against the body this stage was handed.
+    body = up3.parse_shipped_body(runtime, verify_sha=False)
+    if body.archive_sha256 != FS1_SHA256:
+        raise CompressionError(
+            f"the staged runtime carries {body.archive_sha256}, not the FS1 body"
+        )
+    shipped_codes = np.asarray(body.codes, dtype=np.int32)
+    shipped_codes_sha256 = hashlib.sha256(
+        np.ascontiguousarray(shipped_codes).tobytes()
+    ).hexdigest()
+    if shipped_codes_sha256 != FS1_CODES_SHA256:
+        raise CompressionError(
+            f"the FS1 body decodes to codes {shipped_codes_sha256}, not the pinned "
+            f"{FS1_CODES_SHA256}; the re-solve is defined against that table"
+        )
+
+    # The container identity control IS the no-op detector for the whole encode
+    # path -- Rice coding, packed CAP1 metadata, the RR5/DX2 riders, brotli, the
+    # RX1 header and ZIP framing.  If re-encoding the SHIPPED codes does not
+    # reproduce FS1's exact bytes, no byte delta this stage reports is the
+    # carrier's.
+    identity = up3.build_archive(
+        body, shipped_codes, runtime_dir=runtime,
+        container_options=FS2_CONTAINER_OPTIONS,
+    )
+    if (
+        identity["archive_sha256"] != FS1_SHA256
+        or identity["archive_size"] != FS1_BYTES
+        or not identity["packed_metadata_identical"]
+        or not identity["rice_payload_identical"]
+    ):
+        raise CompressionError(
+            "the container identity control FAILED: re-encoding the FS1 body's own "
+            f"codes gives {identity['archive_sha256']} ({identity['archive_size']} B), "
+            f"not {FS1_SHA256} ({FS1_BYTES} B). Refusing to fold."
+        )
+
+    codes, changed_pairs, changed_coordinates = _fs2_codes(shipped_codes)
+    codes_sha256 = hashlib.sha256(np.ascontiguousarray(codes).tobytes()).hexdigest()
+    if codes_sha256 != FS2_CODES_SHA256:
+        raise CompressionError(
+            f"the overlaid code table is {codes_sha256}, not the pinned {FS2_CODES_SHA256}"
+        )
+    if len(changed_pairs) != FS2_CHANGED_PAIRS or changed_coordinates != FS2_CHANGED_COORDINATES:
+        raise CompressionError(
+            f"the overlay moved {len(changed_pairs)} pairs / {changed_coordinates} "
+            f"coordinates, not the recorded {FS2_CHANGED_PAIRS} / {FS2_CHANGED_COORDINATES}"
+        )
+
+    # The alternation's second variable: ONE selector label on an already-active
+    # pair.  The blob length is a function of the active COUNT and the position
+    # SET alone, so a label move inside an unchanged set is byte-free -- MEASURED
+    # here against FS1's own blob rather than assumed.
+    fs1_blob = ra.SPARSE_SELECTOR_PREFIX + bytes(body.body_tail)
+    if hashlib.sha256(fs1_blob).hexdigest() != FS1_SELECTOR_BLOB_SHA256:
+        raise CompressionError(
+            "the FS1 body does not carry the expected 34-byte selector blob"
+        )
+    choices = [(int(pair), int(mode)) for pair, mode in FS2_SELECTOR_CHOICES]
+    blob = _fs1_encode_selector(choices, f0s.decode_selector)
+    blob_sha256 = hashlib.sha256(blob).hexdigest()
+    if blob_sha256 != FS2_SELECTOR_BLOB_SHA256 or len(blob) != FS2_SELECTOR_BLOB_BYTES:
+        raise CompressionError(
+            f"the re-encoded selector blob is {blob_sha256} ({len(blob)} B), not the "
+            f"pinned {FS2_SELECTOR_BLOB_SHA256} ({FS2_SELECTOR_BLOB_BYTES} B)"
+        )
+    if len(blob) != len(fs1_blob):
+        raise CompressionError(
+            f"the selector label move is NOT byte-free: {len(fs1_blob)} B -> {len(blob)} B"
+        )
+    spliced = dataclasses.replace(body, body_tail=blob[len(ra.SPARSE_SELECTOR_PREFIX) :])
+
+    built = up3.build_archive(
+        spliced, codes, runtime_dir=runtime, container_options=FS2_CONTAINER_OPTIONS
+    )
+    candidate = built["archive_bytes"]
+
+    repeat = up3.build_archive(
+        dataclasses.replace(body, body_tail=blob[len(ra.SPARSE_SELECTOR_PREFIX) :]),
+        _fs2_codes(shipped_codes)[0],
+        runtime_dir=runtime,
+        container_options=FS2_CONTAINER_OPTIONS,
+    )["archive_bytes"]
+    if repeat != candidate:
+        raise CompressionError("the in-memory FS2 determinism repeat differs byte-for-byte")
+
+    view = _Fs2ReceiverView(ra, f0s, repack)
+    parsed = _fs1_parse_back(candidate, view, store / "parse_back_candidate")
+    base_parsed = _fs1_parse_back(body.archive_bytes, view, store / "parse_back_base")
+    parsed_choices = parsed.pop("selector_choices")
+    base_choices = base_parsed.pop("selector_choices")
+    if parsed_choices != choices:
+        raise CompressionError(
+            "the written archive parses back to different selector choices; refusing"
+        )
+    if base_choices != [(p, m) for p, m in FS1_SELECTOR_CHOICES]:
+        raise CompressionError("the FS1 parse-back disagrees with its shipped selector")
+    moved = {
+        key: parsed[key] != base_parsed[key]
+        for key in parsed
+    }
+    must_move = ("carrier_cap1_sha256", "carrier_cap1_bytes", "selector_blob_sha256")
+    must_hold = [key for key, changed in moved.items() if changed and key not in must_move]
+    if must_hold:
+        raise CompressionError(
+            f"sections other than the CAP1 carrier and the selector changed: "
+            f"{sorted(must_hold)}; the splice is not one-variable and refuses"
+        )
+    if not moved["carrier_cap1_sha256"]:
+        raise CompressionError(
+            "the CAP1 carrier did NOT move although the codes did; the write was a no-op"
+        )
+    if not moved["selector_blob_sha256"] or parsed["selector_blob_bytes"] != FS2_SELECTOR_BLOB_BYTES:
+        raise CompressionError("the selector blob did not move at its own unchanged length")
+
+    archive_out = store / "fs2_archive.zip"
+    atomic_bytes(archive_out, candidate)
+    atomic_bytes(store / "fs2_selector_blob.bin", blob)
+    atomic_bytes(store / "fs1_selector_blob.bin", fs1_blob)
+    fact = require_pin(archive_out, FINAL_SHA256, FINAL_BYTES)
+    row = {
+        "stage": "fs2",
+        "elapsed_seconds": time.monotonic() - started,
+        "pointer": pointer_fact,
+        "container_identity_control": {
+            "rebuilt_sha256": identity["archive_sha256"],
+            "rebuilt_bytes": identity["archive_size"],
+            "identical_to_pointer": True,
+            "packed_metadata_identical": bool(identity["packed_metadata_identical"]),
+            "rice_payload_identical": bool(identity["rice_payload_identical"]),
+            "rice_bits_shipped": int(identity["rice_bits"]),
+            "container": identity["container"],
+        },
+        "carrier": {
+            "fs1_codes_sha256": shipped_codes_sha256,
+            "fs2_codes_sha256": codes_sha256,
+            "changed_pairs": changed_pairs,
+            "changed_pair_count": len(changed_pairs),
+            "changed_coordinates": changed_coordinates,
+            "rice_bits": int(built["rice_bits"]),
+            "rice_bits_delta": int(built["rice_bits"]) - int(identity["rice_bits"]),
+            "rice_payload_bytes": int(built["rice_payload_bytes"]),
+            "container": built["container"],
+        },
+        "selector": {
+            "fs1_blob_sha256": FS1_SELECTOR_BLOB_SHA256,
+            "fs2_blob_sha256": blob_sha256,
+            "blob_bytes": len(blob),
+            "blob_delta_bytes": len(blob) - len(fs1_blob),
+            "active_pairs": len(choices),
+            "changed_pairs": sorted(
+                pair
+                for pair in set(dict(FS1_SELECTOR_CHOICES)) | set(dict(choices))
+                if dict(FS1_SELECTOR_CHOICES).get(pair, 0) != dict(choices).get(pair, 0)
+            ),
+        },
+        "determinism_repeat": {"mode": "in_memory_reencode_and_splice", "byte_identical": True},
+        "one_variable_parse_back": sorted(key for key, changed in moved.items() if not changed),
+        "archive": fact,
+        "delta_bytes": fact["bytes"] - pointer_fact["bytes"],
+    }
+    return archive_out, row
+
+
+def rebuild_once(run_number: int, store: Path, base: Path, tokens: Path, resume: bool) -> dict[str, Any]:
+    started = time.monotonic()
+    run_root = store / "work" / f"run_{run_number}"
+    retained = store / "retained" / f"run_{run_number}"
+    run_root.mkdir(parents=True, exist_ok=True)
+    retained.mkdir(parents=True, exist_ok=True)
+    stages: list[dict[str, Any]] = []
+
+    rc2_runtime = stage_runtime(run_root / "runtime_rc2", base, "fx2_rc2.py", "residual_pre_dx2.py")
+    fx5_runtime = stage_runtime(run_root / "runtime_fx5", base, "fx2_fx5.py", "residual_pre_dx2.py")
+    fx5, row = encode_stage(
+        label="fx5", store=run_root / "fx5", control_runtime=rc2_runtime,
+        encode_runtime=fx5_runtime, pointer=base, pointer_sha256=BASE_SHA256,
+        tokens=tokens, tag="fx5_e1_19member", resume=resume,
+    )
+    stages.append(row)
+    atomic_copy(fx5, retained / "01_fx5.zip")
+    atomic_copy(fx5, fx5_runtime / "archive.zip")
+
+    dx2, row = fold_dx2_stage(
+        store=run_root / "dx2",
+        runtime=fx5_runtime,
+        pointer=fx5,
+        pointer_sha256=STAGE_PINS["fx5"][0],
+    )
+    stages.append(row)
+    atomic_copy(dx2, retained / "02_dx2.zip")
+    dx2_runtime = stage_runtime(run_root / "runtime_dx2", dx2, "fx2_fx5.py", "residual_dx2.py")
+    atomic_copy(dx2, dx2_runtime / "archive.zip")
+
+    gb1_pointer_runtime = stage_runtime(
+        run_root / "runtime_gb1_pointer", dx2, "fx2_gb1_pointer.py", "residual_dx2.py"
+    )
+    gb1_joint_runtime = stage_runtime(
+        run_root / "runtime_gb1_joint", dx2, "fx2_gb1_joint.py", "residual_dx2.py"
+    )
+    gb1_store = run_root / "gb1"
+    gb1_pointer, row = encode_stage(
+        label="gb1_pointer", store=gb1_store / "pointer", control_runtime=dx2_runtime,
+        encode_runtime=gb1_pointer_runtime, pointer=dx2, pointer_sha256=STAGE_PINS["dx2"][0],
+        tokens=tokens, tag="gb1_groupbin8_surprise", resume=resume,
+    )
+    stages.append(row)
+    gb1_joint, row = encode_stage(
+        label="gb1_joint", store=gb1_store / "joint", control_runtime=dx2_runtime,
+        encode_runtime=gb1_joint_runtime, pointer=dx2, pointer_sha256=STAGE_PINS["dx2"][0],
+        tokens=tokens, tag="gb1_joint21", resume=resume,
+    )
+    stages.append(row)
+    atomic_copy(gb1_pointer, retained / "03a_gb1_pointer.zip")
+    atomic_copy(gb1_joint, retained / "03b_gb1_joint.zip")
+    atomic_copy(gb1_joint, gb1_joint_runtime / "archive.zip")
+
+    lb1_runtime = stage_runtime(run_root / "runtime_lb1", gb1_joint, "fx2_lb1.py", "residual_dx2.py")
+    lb1, row = encode_stage(
+        label="lb1", store=run_root / "lb1", control_runtime=gb1_joint_runtime,
+        encode_runtime=lb1_runtime, pointer=gb1_joint,
+        pointer_sha256=STAGE_PINS["gb1_joint"][0], tokens=tokens,
+        tag="lb1_joint22_patch192", resume=resume,
+    )
+    stages.append(row)
+    atomic_copy(lb1, retained / "04_lb1.zip")
+    atomic_copy(lb1, lb1_runtime / "archive.zip")
+
+    afr1_runtime = stage_runtime(run_root / "runtime_afr1", lb1, "fx2_afr1.py", "residual_dx2.py")
+    afr1, row = encode_stage(
+        label="afr1", store=run_root / "afr1", control_runtime=lb1_runtime,
+        encode_runtime=afr1_runtime, pointer=lb1, pointer_sha256=STAGE_PINS["lb1"][0],
+        tokens=tokens, tag="afr1_tile48_groupbin8", resume=resume,
+    )
+    stages.append(row)
+    atomic_copy(afr1, retained / "05_afr1.zip")
+    fs1_runtime = stage_runtime(run_root / "runtime_fs1", afr1, "fx2_afr1.py", "residual_dx2.py")
+
+    fs1, row = fold_fs1_stage(store=run_root / "fs1", runtime=fs1_runtime, pointer=afr1)
+    stages.append(row)
+    atomic_copy(fs1, retained / "06_fs1.zip")
+
+    fs2_runtime = stage_runtime(run_root / "runtime_fs2", fs1, "fx2_afr1.py", "residual_dx2.py")
+    fs2, row = fold_fs2_stage(store=run_root / "fs2", runtime=fs2_runtime, pointer=fs1)
+    stages.append(row)
+    final = retained / "07_fs2.zip"
+    atomic_copy(fs2, final)
+    fact = require_pin(final, FINAL_SHA256, FINAL_BYTES)
+    result = {
+        "run": run_number,
+        "status": "PASS",
+        "elapsed_seconds": time.monotonic() - started,
+        "stages": stages,
+        "final_archive": fact,
+    }
+    atomic_json(retained / "RESULT.json", result)
+    return result
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--base-archive", default=str(HERE / "base_archive.zip"),
+        help="generation-6 rc2 archive; default is base_archive.zip beside this script",
+    )
+    parser.add_argument(
+        "--store", type=Path, required=True,
+        help="durable SSD work, checkpoints, intermediate archives, and receipts",
+    )
+    parser.add_argument("--repeats", type=int, default=1)
+    parser.add_argument("--resume", action="store_true")
+    return parser.parse_args()
+
+
+def main() -> int:
+    global _ACTIVE_VENDOR
+    args = parse_args()
+    if args.repeats not in (1, 2):
+        raise CompressionError(
+            "--repeats must be 1 (SHA-pinned rebuild) or 2 (adds a full re-run to demonstrate determinism)"
+        )
+    args.store = args.store.expanduser().resolve()
+    if args.store == HERE or HERE in args.store.parents:
+        raise CompressionError("--store must be outside the public source tree")
+    args.store.mkdir(parents=True, exist_ok=True)
+    free = shutil.disk_usage(args.store).free
+    receipt: dict[str, Any] = {
+        "schema": "semantic_joint_ctxmix.compress.v1",
+        "status": "RUNNING",
+        "axis": "[macOS-CPU advisory / scorer-free exact byte measurement]",
+        "score_claim": False,
+        "started_unix": time.time(),
+        "storage_preflight": {"free_bytes": free, "minimum_bytes": 8 << 30},
+        "runs": [],
+    }
+    receipt_path = args.store / "RESULT.json"
+    atomic_json(receipt_path, receipt)
+    try:
+        if free < 8 << 30:
+            raise CompressionError(f"storage preflight requires 8 GiB free; found {free} bytes")
+        tree_rows = verify_tree_manifest()
+        receipt["environment"] = dependency_fingerprint()
+        _ACTIVE_VENDOR = materialize_encoder_sources(args.store)
+        receipt["source_pins"] = verify_sources(tree_rows)
+        atomic_json(receipt_path, receipt)
+        base = obtain_base(args)
+        receipt["base_archive"] = require_pin(base, BASE_SHA256, BASE_BYTES)
+        decode_runtime = stage_runtime(
+            args.store / "work" / "decode_runtime",
+            base,
+            "fx2_rc2.py",
+            "residual_pre_dx2.py",
+        )
+        tokens = args.store / "retained" / "inputs" / "tokens.u8"
+        receipt["token_decode"] = decode_tokens(
+            decode_runtime, tokens, args.store / "retained" / "TOKEN_DECODE.json"
+        )
+        atomic_json(receipt_path, receipt)
+        for run_number in range(1, args.repeats + 1):
+            result = rebuild_once(run_number, args.store, base, tokens, args.resume)
+            receipt["runs"].append(result)
+            atomic_json(receipt_path, receipt)
+        first = Path(receipt["runs"][0]["final_archive"]["path"])
+        if args.repeats == 2:
+            second = Path(receipt["runs"][1]["final_archive"]["path"])
+            if first.read_bytes() != second.read_bytes():
+                raise CompressionError("the two complete rebuilds differ byte-for-byte")
+            receipt["determinism"] = {
+                "mode": "two_full_rebuilds",
+                "byte_identical": True,
+                "run_1": file_fact(first),
+                "run_2": file_fact(second),
+            }
+        else:
+            receipt["determinism"] = {
+                "mode": "single_rebuild_sha_pinned",
+                "note": (
+                    "correctness is enforced by the FINAL_SHA256 pin below and by the "
+                    "per-stage in-memory determinism repeats; pass --repeats 2 for a "
+                    "full second-rebuild demonstration"
+                ),
+                "run_1": file_fact(first),
+            }
+        delivered = args.store / "retained" / "archive.zip"
+        atomic_copy(first, delivered)
+        receipt["archive"] = require_pin(delivered, FINAL_SHA256, FINAL_BYTES)
+        receipt["status"] = "PASS"
+        receipt["elapsed_seconds"] = time.time() - receipt["started_unix"]
+        atomic_json(receipt_path, receipt)
+    except Exception as error:
+        receipt["status"] = "REFUSED"
+        receipt["error"] = f"{type(error).__name__}: {error}"
+        atomic_json(receipt_path, receipt)
+        raise
+    print(json.dumps({"status": "PASS", "archive": receipt["archive"]}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
