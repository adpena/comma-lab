+STORED_CAP_FIELDS = ("scales", "predictor", "lengths", "ks", "basis", "rice")
+LZMA_FILTERS = [
+    {
+        "id": lzma.FILTER_LZMA2,
+        "dict_size": 1 << 16,
+        "lc": 0,
+        "lp": 1,
+        "pb": 0,
