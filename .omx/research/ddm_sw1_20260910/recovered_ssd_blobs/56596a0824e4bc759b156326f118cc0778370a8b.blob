import json, numpy as np, torch, importlib.util
from pathlib import Path
spec = importlib.util.spec_from_file_location('wd4', '/Users/adpena/Projects/pact/experiments/ddm_wd4_warm_lineage_width.py')
wd4 = importlib.util.module_from_spec(spec); spec.loader.exec_module(wd4)
result = json.loads(Path('/Volumes/APDataStore/pact/ddm_wd4_warm_lineage_width/RESULT.json').read_text())
packet = Path(result['gate_candidate']['payloads']['packet']['path']).read_bytes()
model = wd4.receiver.unpack_student(packet)
dev = torch.device('mps'); torch.manual_seed(wd4.SEED); np.random.seed(wd4.SEED)
torch.use_deterministic_algorithms(True)
model.to(dev).train()
tokens = wd4._load_tokens(); pid = wd4.stratified_pair_ids()[0]
tok = tokens[pid:pid+1].long().to(dev); idx = torch.tensor([pid], device=dev)
raw = np.memmap(wd4.FX5_RAW, mode='r', dtype=np.uint8, shape=(1200, wd4.receiver.CAMERA_H, wd4.receiver.CAMERA_W, 3))
tc = torch.from_numpy(np.asarray(raw[2*pid+1]).copy()).permute(2,0,1)[None].float()
tn = torch.nn.functional.interpolate(tc, size=(wd4.receiver.EVAL_H, wd4.receiver.EVAL_W), mode='bilinear', align_corners=False).to(dev)
fq = wd4.receiver.fake_quantize_state(model)
out = torch.func.functional_call(model, fq, (tok, idx))
loss = ((out - tn)/255.0).square().mean()
opt = torch.optim.AdamW(model.parameters(), lr=2e-7, weight_decay=0.0)
opt.zero_grad(set_to_none=True); loss.backward(); opt.step()
torch.mps.synchronize()
print('post-step synced', flush=True)
fq2 = wd4.receiver.fake_quantize_state(model)
bad2 = [(n, int((~torch.isfinite(p)).sum())) for n, p in fq2.items() if not torch.isfinite(p).all()]
print('fq2 nonfinite tensors:', bad2[:6] or 'NONE', flush=True)
with torch.no_grad():
    out2n = torch.func.functional_call(model, {k: v.detach() for k, v in fq2.items()}, (tok, idx))
    print('no-grad fwd2 finite:', bool(torch.isfinite(out2n).all()), flush=True)
out2 = torch.func.functional_call(model, fq2, (tok, idx))
loss2 = ((out2 - tn)/255.0).square().mean()
print('grad-mode fwd2 finite:', bool(torch.isfinite(out2).all().item()), 'loss2:', loss2.detach().item(), flush=True)
fq3 = wd4.receiver.fake_quantize_state(model)
out3 = torch.func.functional_call(model, fq3, (tok, idx))
print('fwd3 (fresh fq) loss:', ((out3 - tn)/255.0).square().mean().detach().item(), flush=True)
