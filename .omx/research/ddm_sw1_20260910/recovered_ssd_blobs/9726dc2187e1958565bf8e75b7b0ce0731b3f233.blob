#!/bin/bash
set -euo pipefail
cd /Users/adpena/Projects/pact
STORE=/Volumes/APDataStore/pact/ddm_pr1_pose_resolve
DALI=/Volumes/VertigoDataTier/pact/ddm_chroma_dali_av_20260809/gt_cache_dali.pt
RUN=/Volumes/VertigoDataTier/pact/ddm_ft1_shipped_renderer_aligned_finetune/runs/aligned_dali_lr2e5_s1800
.venv/bin/python -u experiments/ddm_ft1_verdict_bhw_pose.py \
  --candidate "$RUN/ckpt.stage-expected_flip.step001800.full_state.pt" \
  --gt-cache "$DALI" \
  --pairs 600 --batch-size 4 --threads 4 \
  --label pr1_ft1_step1800_n600 \
  --out "$STORE/retained/verdict_ft1_step1800_n600.json"
echo PR1_FT1_STEP1800_DONE
