#!/bin/bash
set -euo pipefail
cd /Users/adpena/Projects/pact
STORE=/Volumes/APDataStore/pact/ddm_pr1_pose_resolve
DALI=/Volumes/VertigoDataTier/pact/ddm_chroma_dali_av_20260809/gt_cache_dali.pt
TOK=/Volumes/VertigoDataTier/pact/ddm_g8s_single_run_reproof/store_v2/retained/inputs/tokens.u8
BASE_R=/Volumes/VertigoDataTier/pact/ddm_g8s_single_run_reproof/store_v2/retained/archive.zip
.venv/bin/python -u experiments/ddm_pr1_pose_resolve_on_renderer_change.py solve \
  --runtime "$STORE/runtime_afr1" --gt-cache "$DALI" --renderer "$BASE_R" --tokens "$TOK" \
  --pairs 200 --seed 20260904 --threads 4 \
  --label base_control_resolve_n200 --out "$STORE/solve_base_control"
echo PR1_BASE_CONTROL_DONE
