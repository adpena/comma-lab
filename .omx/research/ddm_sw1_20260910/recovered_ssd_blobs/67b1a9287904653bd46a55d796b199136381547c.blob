#!/bin/bash
# ddm_md3 STEP 1 — the DATA-ORDER control.  md1's instrument UNCHANGED on the retained wc3
# seed_20260903 control (SAME init sha 991a1cc6..., DIFFERENT schedule seed => different data
# order only), then analyze on BOTH gt lineages, then md2's site-overlap tool against md1's OWN
# cold-control store (seed_20260902).  This isolates DATA ORDER from INITIALISATION.
# $0, CPU only, 4 threads, one process.  Resumes from disk.  Never writes under any cell's runs/.
set -uo pipefail
cd /Users/adpena/Projects/pact
PY=.venv/bin/python
STORE=/Volumes/APDataStore/pact/ddm_md3_different_initialisation
MD1=/Volumes/APDataStore/pact/ddm_md1_micro_macro
CELL=data_order_control_seed_20260903
COLD=cold_control_seed_20260902
RUN=/Volumes/APDataStore/pact/ddm_wc3_qbr1_ema_law_cure/runs/seed_20260903/control_native100
CFG=/Volumes/APDataStore/pact/ddm_wc3_qbr1_ema_law_cure/sealed_configs/seed_20260903_control_native100.json

echo "=== md3 step1 sweep: data-order control seed_20260903 $(date -u +%FT%TZ) ==="
$PY experiments/ddm_md1_micro_to_macro.py --mode sweep \
    --cell "$CELL" --run-root "$RUN" --config "$CFG" \
    --store "$STORE" --threads 4 --walltime-budget-s 16200
echo "sweep rc=$? $(date -u +%FT%TZ)"

for L in dali pyav; do
  echo "=== md3 step1 analyze $L $(date -u +%FT%TZ) ==="
  $PY experiments/ddm_md1_micro_to_macro.py --mode analyze \
      --cell "$CELL" --gt-lineage "$L" --store "$STORE"
  echo "analyze $L rc=$? $(date -u +%FT%TZ)"
done

for L in dali pyav; do
  echo "=== md3 step1 overlap $L (data-order vs md1 cold control) $(date -u +%FT%TZ) ==="
  $PY experiments/ddm_md2_persistent_site_overlap.py \
      --out-store "$STORE" \
      --a-store "$STORE" --a-cell "$CELL" \
      --b-store "$MD1" --b-cell "$COLD" \
      --gt-lineage "$L" > "$STORE/overlap_dataorder_vs_cold_${L}.stdout.txt" 2>&1
  echo "overlap $L rc=$? $(date -u +%FT%TZ)"
done

echo "=== md3 step1 driver done $(date -u +%FT%TZ) ==="
