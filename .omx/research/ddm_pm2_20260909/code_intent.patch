+    monkeypatch.setattr(pose_cli, "snapshot_pose_pointer", forbidden)
+    monkeypatch.setattr(pose_cli, "check_pose_base", forbidden)
+    assert pose_cli.cmd_pose(pose_args(tmp_path, "stale")) == 0
