{
  "research": [
    "rg",
    "-l",
    "-i",
    "manifest.{0,80}(receiver|digest)|receiver.{0,80}manifest|environment.free digest|prefire",
    ".omx/research",
    "--glob",
    "*.md",
    "--glob",
    "*.json"
  ],
  "graph": [
    "rg",
    "-n",
    "-i",
    "prefire|receiver.digest|content.only digest",
    ".omx/research",
    "--glob",
    "CANONICAL_RESEARCH_INDEX*",
    "--glob",
    "sub015_DAG_*"
  ],
  "design": [
    "rg",
    "-n",
    "-i",
    "prefire|receiver.digest|dependency.manifest",
    "docs",
    "--glob",
    "*.md"
  ],
  "ledger": [
    "rg",
    "-n",
    "-i",
    "ffi4|pr14|rlc4|receiver.digest",
    ".omx/state/canonical_task_status.jsonl",
    ".omx/state/lane_registry.json"
  ],
  "equations": [
    ".venv/bin/python",
    "tools/list_canonical_equations.py",
    "--json"
  ]
}