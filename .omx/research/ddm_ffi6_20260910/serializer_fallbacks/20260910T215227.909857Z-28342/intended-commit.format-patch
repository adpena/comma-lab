+  ],
+  "rows": [
+    {
+      "adjudication_memo": {
+        "bytes": 24850,
+        "path": "/Users/adpena/Projects/pact/.omx/research/ddm_pr16_ratify_amendment3_content_only_first_measurement_digest_20260910.md",
