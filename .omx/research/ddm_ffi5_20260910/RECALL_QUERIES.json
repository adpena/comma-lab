[
  [
    "research",
    [
      "rg",
      "-n",
      "-m",
      "3",
      "runtime.tree.hash|measure_t4_runtime_digest|register_dispatched_call_id|verify_dispatch_paths",
      ".omx/research",
      "--glob",
      "*.md"
    ]
  ],
  [
    "graph",
    [
      "rg",
      "-n",
      "-m",
      "3",
      "first.measurement|runtime.digest|dispatch.path",
      ".omx/research",
      "--glob",
      "CANONICAL_RESEARCH_INDEX*",
      "--glob",
      "sub015_DAG_*"
    ]
  ],
  [
    "design",
    [
      "rg",
      "-n",
      "-m",
      "3",
      "first.measurement|runtime.digest|dispatch.path",
      "docs",
      "SPEC.md"
    ]
  ],
  [
    "ledger",
    [
      "rg",
      "-n",
      "-m",
      "6",
      "first.measurement|runtime.digest|ddm_ffi5",
      ".omx/state/canonical_task_status.jsonl",
      ".omx/state/lane_registry.json"
    ]
  ]
]
