+def test_first_measurement_still_refuses_changed_intent_runtime_digest(fixture, monkeypatch):
+    _, path, tool, _ = prepare_fire(fixture, monkeypatch)
+    fixture["intent"]["candidate"]["runtime"]["sha256"] = "f" * 64
