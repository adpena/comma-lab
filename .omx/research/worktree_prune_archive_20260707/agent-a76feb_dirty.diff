+def _check_273_278_scan_for_token(
+    *,
+    repo_root: Path,
+    forbidden_tokens: Sequence[str],
+    waiver_marker: str,
+    self_exempt_paths: Sequence[str],
+) -> list[tuple[str, int, str]]:
+    """Shared per-line forbidden-token scan with same-line waiver discipline.
+
+    Returns ``[(rel_path, line_no, matched_token), ...]`` for every violation.
+    Same-line ``# <waiver_marker>:<rationale>`` waiver honored when rationale
+    is non-empty AND not the placeholder ``<rationale>`` literal.
+    """
+    violations: list[tuple[str, int, str]] = []
+    for sub in ("src/tac", "tools", "experiments"):
+        base = repo_root / sub
+        if not base.is_dir():
+            continue
+        for path in sorted(base.rglob("*.py")):
+            rel = str(path.relative_to(repo_root))
+            if any(marker in rel for marker in self_exempt_paths):
+                continue
+            try:
+                text = path.read_text(encoding="utf-8", errors="replace")
+            except OSError:
+                continue
+            for tok in forbidden_tokens:
+                if tok not in text:
+                    continue
+                for ln_no, line in enumerate(text.split("\n"), 1):
+                    if tok not in line:
+                        continue
+                    waiver_token = f"# {waiver_marker}:"
+                    if waiver_token in line:
+                        rationale = line.split(waiver_token, 1)[1].strip()
+                        if rationale and rationale != "<rationale>":
+                            continue
+                    violations.append((rel, ln_no, tok))
+    return violations
+
