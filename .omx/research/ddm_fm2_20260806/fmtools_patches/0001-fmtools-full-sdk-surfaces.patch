+def test_capability_report_is_typed_and_fail_soft() -> None:
+    class FakeSession:
+        def __init__(self, instructions=None, model=None, tools=None):
+            pass
+
+        async def respond(self, prompt, *, generating=None, json_schema=None, options=None):
+            return "ok"
+
+        async def stream_response(self, prompt, *, options=None):
+            yield "ok"
+
+        @classmethod
+        def from_transcript(cls, transcript, model=None, tools=None):
+            return cls()
+
+    fake_sdk = MagicMock()
+    fake_sdk.LanguageModelSession = FakeSession
+    fake_sdk.SystemLanguageModel = MagicMock
+    fake_sdk.GenerationOptions = object
+    fake_sdk.Tool = object
+    fake_sdk.Transcript = object
+    fake_sdk.SystemLanguageModelUseCase = object
+
+    with (
