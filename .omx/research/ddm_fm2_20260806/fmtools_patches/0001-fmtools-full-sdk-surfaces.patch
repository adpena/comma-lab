new file mode 100644
index 0000000..3f2c99f
--- /dev/null
+++ b/fmtools/session.py
@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, TypeVar
+
+if TYPE_CHECKING:
+    from collections.abc import AsyncIterator
+
+from .capabilities import FMCapabilityReport, capability_report
+from .exceptions import ensure_model_available
+from .protocols import create_model, create_session
+
+T = TypeVar("T")
+
+
+@dataclass(frozen=True)
+class FMGenerationControls:
+    """Portable request controls that map onto apple_fm_sdk.GenerationOptions when present."""
+
+    temperature: float | None = None
+    maximum_response_tokens: int | None = None
+    sampling: Any | None = None
+
+    def to_sdk_options(self) -> Any | None:
+        if self.temperature is None and self.maximum_response_tokens is None and self.sampling is None:
+            return None
+        import apple_fm_sdk as fm
+
+        return fm.GenerationOptions(
+            sampling=self.sampling,
+            temperature=self.temperature,
+            maximum_response_tokens=self.maximum_response_tokens,
+        )
+
+
+async def respond(
+    prompt: str,
+    *,
+    instructions: str = "",
+    generating: type[T] | T | None = None,
+    schema: Any | None = None,
+    json_schema: dict[str, Any] | None = None,
+    options: Any | None = None,
+    controls: FMGenerationControls | None = None,
+    tools: list[Any] | None = None,
+    model: Any | None = None,
+) -> Any:
+    """One-shot session response with guided generation, tools, and per-call options."""
+    resolved_model = model if model is not None else create_model()
+    ensure_model_available(resolved_model, context="respond")
+    session = create_session(instructions=instructions, model=resolved_model, tools=tools)
+    resolved_options = options if options is not None else (
+        controls.to_sdk_options() if controls is not None else None
+    )
+    kwargs: dict[str, Any] = {}
+    if generating is not None:
+        kwargs["generating"] = generating
+    if schema is not None:
+        kwargs["schema"] = schema
+    if json_schema is not None:
+        kwargs["json_schema"] = json_schema
+    if resolved_options is not None:
+        kwargs["options"] = resolved_options
+    return await session.respond(prompt, **kwargs)
+
+
+async def stream_response(
+    prompt: str,
+    *,
+    instructions: str = "",
+    options: Any | None = None,
+    controls: FMGenerationControls | None = None,
+    tools: list[Any] | None = None,
+    model: Any | None = None,
+) -> AsyncIterator[str]:
+    """Yield text snapshots from the active backend's streaming response surface."""
+    resolved_model = model if model is not None else create_model()
+    ensure_model_available(resolved_model, context="stream_response")
+    session = create_session(instructions=instructions, model=resolved_model, tools=tools)
+    stream = getattr(session, "stream_response", None)
+    if not callable(stream):
+        raise NotImplementedError("Active backend does not support stream_response().")
+    resolved_options = options if options is not None else (
+        controls.to_sdk_options() if controls is not None else None
+    )
+    async for chunk in stream(prompt, options=resolved_options):
+        yield chunk
+
+
+__all__ = [
+    "FMCapabilityReport",
+    "FMGenerationControls",
+    "capability_report",
+    "respond",
+    "stream_response",
+]
