+
+@dataclass(frozen=True)
+class FMCapabilityReport:
+    backend: str
+    sdk_package: str | None
+    sdk_version: str | None
+    model_available: bool
+    availability_reason: str | None
+    supports_guided_generation: bool
+    supports_json_schema: bool
+    supports_tools: bool
+    supports_streaming: bool
+    supports_generation_options: bool
+    supports_transcripts: bool
+    supports_model_controls: bool
+    respond_signature: str | None
+    stream_response_signature: str | None
+    error: str | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def capability_report(model: Any | None = None, backend: Any | None = None) -> FMCapabilityReport:
+    """Return a typed, fail-soft report of the active Foundation Models surface."""
+    active_backend = backend if backend is not None else get_backend()
+    backend_name = type(active_backend).__name__
+    error: str | None = None
+
+    try:
+        resolved_model = model if model is not None else create_model()
+    except Exception as exc:
+        resolved_model = None
+        error = f"{type(exc).__name__}: {exc}"
+
+    available = False
+    reason: str | None = None
+    if resolved_model is not None:
+        try:
+            available, raw_reason = resolved_model.is_available()
+            reason = None if raw_reason is None else str(raw_reason)
+        except Exception as exc:
+            reason = f"{type(exc).__name__}: {exc}"
+
+    sdk = _import_sdk()
+    sdk_version = _package_version("apple-fm-sdk") if sdk is not None else None
+    session_cls = getattr(sdk, "LanguageModelSession", None) if sdk is not None else None
+    model_cls = getattr(sdk, "SystemLanguageModel", None) if sdk is not None else None
+
+    respond_sig = _signature(getattr(session_cls, "respond", None))
+    stream_sig = _signature(getattr(session_cls, "stream_response", None))
+    respond_params = _signature_params(getattr(session_cls, "respond", None))
+    init_params = _signature_params(session_cls)
+    model_params = _signature_params(model_cls)
+
+    supports_guided = "generating" in respond_params or "schema" in respond_params
+    supports_json_schema = "json_schema" in respond_params
+    supports_tools = "tools" in init_params and hasattr(sdk, "Tool")
+    supports_streaming = hasattr(session_cls, "stream_response")
+    supports_options = hasattr(sdk, "GenerationOptions") and (
+        "options" in respond_params or "options" in _signature_params(getattr(session_cls, "stream_response", None))
+    )
+    supports_transcripts = hasattr(sdk, "Transcript") and hasattr(session_cls, "from_transcript")
+    supports_model_controls = any(p not in {"self", "_ptr"} for p in model_params) or hasattr(
+        sdk, "SystemLanguageModelUseCase"
+    )
+
+    return FMCapabilityReport(
+        backend=backend_name,
+        sdk_package="apple-fm-sdk" if sdk is not None else None,
+        sdk_version=sdk_version,
+        model_available=bool(available),
+        availability_reason=reason,
+        supports_guided_generation=supports_guided,
+        supports_json_schema=supports_json_schema,
+        supports_tools=supports_tools,
+        supports_streaming=supports_streaming,
+        supports_generation_options=supports_options,
+        supports_transcripts=supports_transcripts,
+        supports_model_controls=supports_model_controls,
+        respond_signature=respond_sig,
+        stream_response_signature=stream_sig,
+        error=error,
+    )
+
+
+def _import_sdk() -> Any | None:
+    try:
+        return importlib.import_module("apple_fm_sdk")
+    except Exception:
+        return None
+
+
+def _package_version(package: str) -> str | None:
+    try:
+        return metadata.version(package)
+    except metadata.PackageNotFoundError:
+        return None
+
+
+def _signature(callable_obj: Any) -> str | None:
+    if callable_obj is None:
+        return None
+    try:
+        return str(inspect.signature(callable_obj))
+    except Exception:
+        return None
+
+
+def _signature_params(callable_obj: Any) -> set[str]:
+    if callable_obj is None:
+        return set()
+    try:
+        return set(inspect.signature(callable_obj).parameters)
+    except Exception:
+        return set()
