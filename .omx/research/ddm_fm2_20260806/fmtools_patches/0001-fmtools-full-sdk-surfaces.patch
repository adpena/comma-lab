+++ b/tests/test_full_sdk_surfaces.py
@@ -0,0 +1,194 @@
+from __future__ import annotations
+
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+from fmtools.backends.apple_sdk import AppleFMSession
+from fmtools.capabilities import capability_report
+from fmtools.decorators import local_extract
+from fmtools.protocols import create_session
+from fmtools.session import FMGenerationControls, respond, stream_response
+
+from .conftest import MockSchema, make_mock_model, make_mock_session
+
+
+async def test_create_session_passes_tools_to_apple_backend() -> None:
+    model = make_mock_model(available=True)
+    session = make_mock_session()
+    tool = object()
+
+    with patch("apple_fm_sdk.LanguageModelSession", return_value=session) as session_cls:
+        created = create_session("Use tools.", model=model, tools=[tool])
+
+    assert created.raw is session
+    session_cls.assert_called_once_with(
+        model=model.raw,
+        instructions="Use tools.",
+        tools=[tool],
+    )
+
+
+async def test_local_extract_forwards_options_and_tools() -> None:
+    model = make_mock_model(available=True)
+    session = make_mock_session(respond_return=MockSchema(name="Ada"))
+    option = object()
+    tool = object()
+
+    with (
+        patch("fmtools.decorators.create_model", return_value=model),
+        patch("fmtools.decorators.create_session", return_value=session) as create_session_mock,
+    ):
+
+        @local_extract(schema=MockSchema, retries=1, options=option, tools=[tool])
+        async def extract_name(text: str) -> MockSchema:
+            """Extract a name."""
+
+        result = await extract_name("Ada")
+
+    assert result == MockSchema(name="Ada")
+    create_session_mock.assert_called_once_with(
+        instructions="Extract a name.",
+        model=model,
+        tools=[tool],
+    )
+    session.respond.assert_awaited_once_with("Ada", generating=MockSchema, options=option)
+
+
+async def test_one_shot_respond_supports_json_schema_and_controls() -> None:
+    model = make_mock_model(available=True)
+    session = make_mock_session(respond_return={"label": "ok"})
+    options = object()
+    controls = MagicMock(spec=FMGenerationControls)
+    controls.to_sdk_options.return_value = options
+
+    with (
+        patch("fmtools.session.create_model", return_value=model),
+        patch("fmtools.session.create_session", return_value=session) as create_session_mock,
+    ):
+        result = await respond(
+            "Classify.",
+            instructions="Use schema.",
+            json_schema={"type": "object"},
+            controls=controls,
+            tools=[],
+        )
+
+    assert result == {"label": "ok"}
+    create_session_mock.assert_called_once_with(instructions="Use schema.", model=model, tools=[])
+    session.respond.assert_awaited_once_with(
+        "Classify.",
+        json_schema={"type": "object"},
+        options=options,
+    )
+
+
+async def test_apple_session_stream_response_yields_snapshots() -> None:
+    model = make_mock_model(available=True)
+
+    async def fake_stream(prompt: str, *, options=None):
+        assert prompt == "tell"
+        assert options == "opts"
+        yield "h"
+        yield "hi"
+
+    raw_session = MagicMock()
+    raw_session.stream_response = fake_stream
+    with patch("apple_fm_sdk.LanguageModelSession", return_value=raw_session):
+        session = AppleFMSession(model, "Stream.")
+
+    assert [chunk async for chunk in session.stream_response("tell", options="opts")] == ["h", "hi"]
+
+
