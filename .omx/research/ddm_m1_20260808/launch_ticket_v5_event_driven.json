  "fire_guard_tool": "tools/mx1_fire_guard.py",
  "fire_guard_verdict_schema": "ddm_mx1_fire_guard_verdict.v1",
  "fire_protocol": {
    "anti_pattern": "no || true around the fallback enumerator; denied ps is not quiescence",
    "pre_fire_liveness_proof": "successful process enumerator required before every fire; pgrep rc>=2 AND ps rc!=0 => REFUSE (rr8 F1)",
    "scheduling": "SEQUENTIAL one-Metal-fire-at-a-time"
  },
  "main_fire_sequence": [
    {
      "command_ref": "mem_probe_command",
      "expected": "receipt status=passed at the REAL saturated config; chunk-cache residency measured not assumed",
      "step": "mem_probe"
    },
    {
      "command_ref": "sigma_calibration.protocol",
      "expected": "sanity_sigma_measured + fp16_fp32_delta_measured filled into this ticket; seal_falsifiers all pass",
      "step": "sigma_calibration"
    },
    {
      "expected": "independent codex arm over the SEALED ticket; empty findings table advances counter to 2/3; any finding resets to 0/3 (gc21 reset condition)",
      "step": "review_pass_2"
    },
    {
      "expected": "counter 3/3",
      "step": "review_pass_3"
    },
    {
      "command": [
        ".venv/bin/python",
