      "expected": "status=passed against the saturated receipt",
      "step": "guard_gate"
    },
    {
      "command_ref": "argv_m1_n120_cap_saturated",
      "expected": "MAIN fires; SEQUENTIAL one-Metal-fire-at-a-time; entrypoint re-runs the guard before MLX setup; windows resume per stop_policy",
      "step": "fire"
    }
  ],
