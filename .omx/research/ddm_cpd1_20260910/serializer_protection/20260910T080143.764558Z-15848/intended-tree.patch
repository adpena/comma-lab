+
+def test_preflight_rejects_corrupt_journal_even_with_audit_waiver(tmp_path):
+    _json(tmp_path, POINTER, {"frontier_disqualification_waiver": RATIONALE})
+    (tmp_path / JOURNAL).write_text("malformed journal\n")
