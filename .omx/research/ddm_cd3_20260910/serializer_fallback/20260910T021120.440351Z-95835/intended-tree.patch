+    result = dict(binding=binding(root), x=array_file(root / 'retained/fit/x.npy', x),
+                  truth=array_file(root / 'retained/fit/truth.npy', y),
+                  events=len(y), all_source_probabilities_identical=True,
+                  weight_count=24, model_family='scale_geometry_history_shared',
+                  scope='one shared vector; six named context families plus adaptation timescale and count priors')
