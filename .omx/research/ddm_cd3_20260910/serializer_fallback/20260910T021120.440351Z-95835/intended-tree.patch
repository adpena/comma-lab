+def _sz1_unsplit_semantic(body: bytes) -> bytes:
+    """Restore interleaved fp16 metadata from its two byte planes (exact inverse)."""
+    start = SZ1_SPLIT_OFFSET
+    end = start + SZ1_SPLIT_LENGTH
